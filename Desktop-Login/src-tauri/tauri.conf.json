{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlakeSecure Desktop Login",
  "version": "1.0.0",
  "identifier": "dev.snowystudio.flakesecure.desktoplogin",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "menu",
        "title": "FlakeSecure Desktop Login",
        "url": "index.html",
        "width": 540,
        "height": 700,
        "minWidth": 460,
        "minHeight": 580,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "overlay",
        "title": "FlakeSecure QR Overlay",
        "url": "overlay.html",
        "width": 360,
        "height": 470,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://flakesecure.snowystudio.dev wss://flakesecure.snowystudio.dev https://* wss://*; img-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
