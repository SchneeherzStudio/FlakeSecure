{
  "name": "flakesecure-desktop-admin",
  "version": "2.0.3",
  "description": "FlakeSecure Desktop Admin Panel - Cross-platform System & Announcement Management for Windows and Linux",
  "main": "main.js",
  "author": "SchneeherzStudio / Snowy Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -wl"
  },
  "build": {
    "appId": "dev.snowystudio.flakesecure.admin",
    "productName": "FlakeSecure Admin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "FlakeSecure Admin Dashboard",
      "description": "Administrative Control Panel for FlakeSecure Announcements and Maintenance Mode."
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
