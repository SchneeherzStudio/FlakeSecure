# FlakeSecure Server Configuration Template
# Copy this file to .env and replace placeholders with real values.

# Server Environment
NODE_ENV=production
PORT=443
HTTP_PORT=80

# PostgreSQL Database
PGHOST=localhost
PGPORT=5432
PGDATABASE=flakesecure
PGUSER=postgres
PGPASSWORD=your_secure_db_password

# Authentication & Cryptography
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_random_64_byte_hex_jwt_secret_here

# Administrator Credentials & Secret
# Admin secret for API / Desktop Admin
ADMIN_SECRET=your_random_32_byte_hex_admin_secret_here
# Admin Web Portal Login Credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password

# SMTP Email Configuration (for OTP, Welcome, Deletion, and Critical Alerts)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=FlakeSecure Security <noreply@yourdomain.com>

# Spend Caps / Quotas
# Maximum OTP emails per IP per hour
MAX_OTP_PER_IP_HOURLY=10
# Maximum global emails per day
MAX_EMAILS_PER_DAY=1000

# Client Origins for CORS (comma-separated, or * for public APIs)
ALLOWED_ORIGINS=https://flakesecure.snowystudio.dev
